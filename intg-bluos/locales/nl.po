# Initial setup page
msgid "BluOS Integration"
msgstr "BluOS-integratie"

msgid "Information"
msgstr "Informatie"

msgid "This integration allows you to control BluOS-enabled streaming players including Bluesound, NAD, and DALI devices."
msgstr "Met deze integratie bedien je streamingspelers met BluOS, waaronder apparaten van Bluesound, NAD en DALI."

msgid "Click 'Next' to start device discovery."
msgstr "Klik op 'Volgende' om apparaten te zoeken."
