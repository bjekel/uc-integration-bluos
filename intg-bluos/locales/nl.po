# Configuration mode
msgid "BluOS Configuration"
msgstr "BluOS-configuratie"

msgid "Configured devices"
msgstr "Geconfigureerde apparaten"

msgid "Action"
msgstr "Actie"

msgid "Add a new device"
msgstr "Nieuw apparaat toevoegen"

msgid "Configure selected device"
msgstr "Geselecteerd apparaat configureren"

msgid "Remove selected device"
msgstr "Geselecteerd apparaat verwijderen"

msgid "Reset configuration"
msgstr "Configuratie resetten"

msgid "Backup configuration"
msgstr "Configuratie back-uppen"

msgid "Restore configuration from backup"
msgstr "Configuratie herstellen uit back-up"

# Backup / restore
msgid "Backup"
msgstr "Back-up"

msgid "Copy the configuration below and keep it somewhere safe. Use 'Restore configuration from backup' to load it again."
msgstr "Kopieer de configuratie hieronder en bewaar die op een veilige plek. Gebruik 'Configuratie herstellen uit back-up' om hem weer te laden."

msgid "Configuration"
msgstr "Configuratie"

msgid "Restore configuration"
msgstr "Configuratie herstellen"

msgid "Restore"
msgstr "Herstellen"

msgid "Paste a previously saved backup. All configured devices will be replaced."
msgstr "Plak een eerder opgeslagen back-up. Alle geconfigureerde apparaten worden vervangen."

msgid "Error"
msgstr "Fout"

msgid "The configuration could not be read. Please paste a valid backup."
msgstr "De configuratie kon niet worden gelezen. Plak een geldige back-up."

